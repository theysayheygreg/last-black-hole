  "mapPolicies": {
    "shallows": {
      "mode": "fixed-curated",
      "drawStream": null,
      "fixedCast": [
        "base-well"
      ],
      "eligibleCatalogIds": [
        "base-well"
      ]
    },
    "expanse": {
      "mode": "seeded-draw",
      "drawStream": "anomalyCatalog",
      "fixedCast": [],
      "eligibleCatalogIds": [
        "base-well",
        "micro-black-hole",
        "pulsar"
      ]
    },
    "deep-field": {
      "mode": "seeded-draw",
