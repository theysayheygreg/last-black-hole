#!/usr/bin/env bash
set -euo pipefail

remote="${1:-}"

if [[ -n "$remote" && "$remote" != "origin" ]]; then
  exit 0
fi

main_local_sha=""
main_remote_sha=""
while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_ref" == "refs/heads/main" && ! "$local_sha" =~ ^0+$ ]]; then
    main_local_sha="$local_sha"
    main_remote_sha="$remote_sha"
  fi
done

if [[ -z "$main_local_sha" ]]; then
  echo "LBH release pre-push check skipped: origin/main is not being updated."
  exit 0
fi

scope="$(node scripts/push-scope.cjs "$main_remote_sha" "$main_local_sha")"
if [[ "$scope" == "process-only" ]]; then
  echo "LBH release pre-push check skipped: pushed range is docs, tests, or process only."
  exit 0
fi

node scripts/release.cjs prepush
