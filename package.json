{
  "name": "last-singularity",
  "version": "0.2.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "play": "node scripts/play.cjs",
    "start": "node scripts/stack.cjs start --mode=local-host",
    "stop": "node scripts/stack.cjs stop",
    "dev": "node scripts/dev-server.cjs start",
    "dev:stop": "node scripts/dev-server.cjs stop",
    "dev:status": "node scripts/dev-server.cjs status",
    "dev:restart": "node scripts/dev-server.cjs restart",
    "stack": "node scripts/stack.cjs start --mode=local-host",
    "stack:browser": "node scripts/stack.cjs start --mode=local-browser",
    "stack:remote": "node scripts/stack.cjs start --mode=remote-client",
    "stack:stop": "node scripts/stack.cjs stop",
    "stack:status": "node scripts/stack.cjs status",
    "stack:restart": "node scripts/stack.cjs restart --mode=local-host",
    "sim": "node scripts/sim-server.cjs start",
    "sim:stop": "node scripts/sim-server.cjs stop",
    "sim:status": "node scripts/sim-server.cjs status",
    "sim:restart": "node scripts/sim-server.cjs restart",
    "control": "node scripts/control-plane-server.cjs start",
    "control:stop": "node scripts/control-plane-server.cjs stop",
    "control:status": "node scripts/control-plane-server.cjs status",
    "control:restart": "node scripts/control-plane-server.cjs restart",
    "test": "node tests/run-all.cjs",
    "test:fast": "node tests/run-all.cjs --fast",
    "test:telemetry": "node tests/telemetry-smoke.cjs",
    "test:renderer": "node tests/renderer.cjs",
    "test:perf": "node tests/perf-probe.cjs",
    "test:title-prototype": "node tests/probe-title-prototype.cjs",
    "test:audio": "node tests/audio-toolkit.cjs",
    "audio:analyze": "sh -c 'PY=.venv/bin/python; [ -x \"$PY\" ] || PY=python3; exec \"$PY\" tools/audio_workbench.py \"$@\"' --",
    "build": "node scripts/build.cjs",
    "build:release": "node scripts/build.cjs --mode=release",
    "build:test": "node scripts/build.cjs --mode=test",
    "build:dev": "node scripts/build.cjs --mode=dev",
    "build:web": "node scripts/build.cjs --targets=web",
    "build:desktop": "node scripts/build.cjs --targets=web,mac,win,linux,ipad"
  },
  "keywords": [],
